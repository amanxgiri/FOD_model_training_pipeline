# Kaggle authentication: either these variables or a local kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_CONFIG_DIR=

# GitHub publication
GH_TOKEN=
GITHUB_REPOSITORY=owner/repository

# Optional project-root-relative path overrides
FOD_DATA_ROOT=./data
FOD_RUNS_ROOT=./runs
FOD_ARTIFACTS_ROOT=./artifacts

# Optional GPU selection
CUDA_VISIBLE_DEVICES=0
